            "{root}/modules/model/run_model.py",
            "--design",
            "{design}",
            "--domain",
            "all",
            "--fold",
            "all",
            "--output",
            "{out}/training"
          ],
          "reports": []
        }
      ],
      "starting_point": "Formal prepared training and process tables, QA/QC scores and frozen folds.",
      "interpretation": "Training completed for all domains and folds of the selected design."
