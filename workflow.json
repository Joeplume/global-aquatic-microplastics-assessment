    "model-fold": {
      "jobs": [
        {
          "name": "training",
          "argv": [
            "{python}",
            "{root}/modules/model/run_model.py",
            "--design",
            "{design}",
            "--domain",
            "{domain}",
            "--fold",
            "{fold}",
            "--output",
            "{out}/training"
          ],
          "reports": []
        }
      ],
      "starting_point": "Formal prepared training and process tables, QA/QC scores and frozen folds.",
      "interpretation": "Training completed for the selected fold."
    },
    "model-all": {
      "jobs": [
        {
          "name": "training",
          "argv": [
