{
  "qaqc": {
    "required_fields": ["source_doi", "waterbody_group", "longitude", "latitude", "original_concentration_value", "original_concentration_unit", "particle_size_lower_um", "detection_method"],
    "minimum_completeness": 0.8,
    "minimum_score": 0.5,
    "criterion_columns": {
      "A": "qaqc_A",
      "B": "qaqc_B",
      "C": "qaqc_C",
      "D": "qaqc_D",
      "E": "qaqc_E",
      "F": "qaqc_F",
      "G": "qaqc_G"
    }
  },
  "particle_size": {
    "alpha": 1.7,
    "reference_lower_um": 10.0,
    "reference_upper_um": 5000.0
  },
  "features": ["sampling_year", "longitude", "latitude", "annual_runoff_mm_2020", "night_lights_radiance_2020", "plastic_waste_generation_t", "positive_water_depth_m", "wind10m_ms_2020", "wgi_government_effectiveness_2020"],
  "model": {
    "domains": ["reference_surface_freshwater", "transition_coastal", "marine", "wastewater", "drinking_living"],
    "hidden_widths": [32, 16],
    "prior_scale": 1.0,
    "learning_rate": 0.01,
    "epochs": 120,
    "seed": 17
  },
  "validation": {
    "modes": ["random", "spatial", "source", "spatial_source"],
    "folds": 5
  },
  "prediction": {
    "draws": 200
  },
  "monitoring": {
    "site_budgets": [25, 50, 100, 250, 500],
    "occasions": 6,
    "rho": 0.3
  }
}
